PORT=3000

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/miras_grove

# --- Auth ---
# any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
# check console.groq.com/docs/models for what is currently available
# comma-separated = fallback order (next one is tried only on 404 model-not-found)
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional: serve a different frontend folder instead of ./public
# STATIC_DIR=D:/some/other/folder
